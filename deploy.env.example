# Copy to deploy.env (gitignored) and fill in, then:  source deploy.env
#
# These currently live in plaintext inside post-deploy-check.sh, which is
# committed. Rotate them, put them here, and strip them from that script.
#
# Better still: install an SSH key on each node and leave the *_SSH_PASS
# variables empty — both scripts fall back to key auth with BatchMode, which
# removes the sshpass dependency and the password from your shell history.

export RETICHAT_SSH_HOST="retichat@retichat.com"
export RETICHAT_SSH_PASS=""

export SELECTIV_SSH_HOST="selectiv@selectivesubconscious.com"
export SELECTIV_SSH_PASS=""
